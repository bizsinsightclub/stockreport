<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8" />
<title>KRX 종목 일일 리포트</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@300;400&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+KR:wght@300;400&display=swap" rel="stylesheet">
<style>
  :root{--bg:#0f0f10;--surface:#16161a;--text:#e8e6e3;--muted:#7a7a82;--border:#26262b;--accent:#d4a574}
  *{box-sizing:border-box;margin:0;padding:0}
  body{background:var(--bg);color:var(--text);font-family:'Noto Sans KR',sans-serif;padding:48px 32px}
  .container{max-width:880px;margin:0 auto}
  h1{font-family:'Fraunces',serif;font-weight:300;font-size:2.4rem;margin-bottom:8px}
  h1 em{font-style:italic;color:var(--accent)}
  .sub{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--muted);margin-bottom:32px;letter-spacing:.1em}
  ul{list-style:none}
  li{padding:14px 0;border-bottom:1px solid var(--border);display:grid;grid-template-columns:140px 1fr auto;gap:16px;align-items:baseline}
  li a{color:var(--text);text-decoration:none;border-bottom:1px dotted var(--muted)}
  li a:hover{color:var(--accent);border-color:var(--accent)}
  .ticker-code{font-family:'JetBrains Mono',monospace;font-size:13px}
  .name{font-size:14px}
  .latest{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--muted)}
</style>
</head>
<body>
<div class="container">
  <h1>KRX 종목 <em>리포트</em></h1>
  <div class="sub">Daily Equity Briefs · {{ generated_at }} KST</div>

  <ul>
  {% for t in tickers %}
    <li>
      <span class="ticker-code"><a href="{{ t.ticker }}/index.html">{{ t.ticker }}</a></span>
      <span class="name">{{ t.name or t.ticker }}</span>
      <span class="latest">최신 {{ t.latest_date }} · {{ t.count }}건</span>
    </li>
  {% else %}
    <li>아직 종목이 없습니다.</li>
  {% endfor %}
  </ul>
</div>
</body>
</html>
