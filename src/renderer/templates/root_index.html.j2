<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8" />
<title>KRX 종목·시장 일일 리포트</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@300;400&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+KR:wght@300;400;500&display=swap" rel="stylesheet">
{% include "_etp_styles.html.j2" %}
</head>
<body>
<div class="container">

  <header>
    <div class="brand">Daily Equity & ETP Brief</div>
    <h1>KRX 종목·시장 <em>리포트</em></h1>
    <div class="sub">Generated {{ generated_at }}{% if market_overview and market_overview.as_of %} · 시장 기준일 {{ market_overview.as_of }}{% endif %}</div>
  </header>

  {% if market_overview %}
  {% set ovs = market_overview.overviews %}
  {% set st = market_overview.statuses %}

  <!-- 시장 요약 -->
  <section>
    <div class="section-head">
      <div class="section-num">01 / MARKET</div>
      <h2 class="section-title">시장 <em>개요</em> · ETF / ETN / ELW</h2>
    </div>
    <div class="summary-grid">
      {% for kind in ['ETF','ETN','ELW'] %}
      {% set ov = ovs.get(kind) %}
      <div class="summary-card">
        <div class="summary-name">{{ kind }}{% if kind == 'ETN' and st.etn != 200 %} · API 미승인 ({{ st.etn }}){% elif kind == 'ELW' and st.elw != 200 %} · API 미승인 ({{ st.elw }}){% endif %}</div>
        {% if ov and ov.count > 0 %}
        <div class="summary-stat">
          <div class="summary-cell"><div class="label">종목수</div><div class="val">{{ "{:,}".format(ov.count) }}</div></div>
          <div class="summary-cell"><div class="label">거래대금 합계</div><div class="val">{% if ov.total_traded_oku is not none %}{{ "{:,.0f}".format(ov.total_traded_oku) }} 억원{% else %}—{% endif %}</div></div>
          <div class="summary-cell"><div class="label">상승 / 하락</div><div class="val"><span class="gainers">{{ ov.gainers }}</span> / <span class="losers">{{ ov.losers }}</span></div></div>
          <div class="summary-cell"><div class="label">시가총액 합계</div><div class="val">{% if ov.total_market_cap_oku %}{{ "{:,.0f}".format(ov.total_market_cap_oku) }} 억원{% else %}—{% endif %}</div></div>
        </div>
        {% else %}
        <div class="placeholder" style="margin:0;padding:14px">데이터 없음 — 해당일 미게시 또는 KRX OpenAPI ETP API 미승인</div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    {% if market_archives %}
    <div class="sub" style="margin-top:16px">전체 ETF/ETN/ELW 정렬·필터·검색 →
      <a href="{{ market_archives[0].href }}">시장 대시보드 ({{ market_archives[0].date }})</a></div>
    {% endif %}
  </section>

  <!-- 인사이트 -->
  {% if market_overview.insights %}
  <section>
    <div class="section-head">
      <div class="section-num">02 / INSIGHTS</div>
      <h2 class="section-title">오늘의 <em>시장 인사이트</em></h2>
    </div>
    <ul class="insights">
      {% for s in market_overview.insights %}<li>{{ s }}</li>{% endfor %}
    </ul>
  </section>
  {% endif %}
  {% endif %}

  <!-- 분석된 종목 리스트 -->
  <section>
    <div class="section-head">
      <div class="section-num">{% if market_overview %}03{% else %}01{% endif %} / TICKERS</div>
      <h2 class="section-title">분석된 <em>종목</em></h2>
    </div>
    <ul class="ticker-list">
    {% for t in tickers %}
      <li>
        <span class="monogram" data-noverify="true">{{ (t.name or t.ticker)[0] }}</span>
        <div>
          <div class="info-name"><a href="{{ t.ticker }}/index.html">{{ t.name or t.ticker }}</a></div>
          <div class="info-meta">{{ t.ticker }}{% if t.market %} · {{ t.market }}{% endif %}{% if t.sector_name %} · {{ t.sector_name }}{% endif %}</div>
        </div>
        <span class="latest">최신 <span class="date">{{ t.latest_date }}</span><br>{{ t.count }}건</span>
      </li>
    {% else %}
      <li>아직 종목이 없습니다.</li>
    {% endfor %}
    </ul>
  </section>

  <!-- 지난 시장 리포트 (날짜별 아카이브) -->
  {% if market_archives %}
  <section>
    <div class="section-head">
      <div class="section-num">{% if market_overview %}04{% else %}02{% endif %} / ARCHIVE</div>
      <h2 class="section-title">지난 <em>시장 리포트</em></h2>
    </div>
    <ul class="ticker-list">
    {% for a in market_archives %}
      <li>
        <span class="monogram" data-noverify="true">M</span>
        <div>
          <div class="info-name"><a href="{{ a.href }}">시장 개요 · {{ a.date }}</a></div>
          <div class="info-meta">ETF / ETN / ELW · 정렬·필터 대시보드</div>
        </div>
        <span class="latest"><span class="date">{{ a.date }}</span></span>
      </li>
    {% endfor %}
    </ul>
  </section>
  {% endif %}

  <footer>
    데이터 소스: KRX OpenAPI · pykrx · DART OpenAPI · Frankfurter (ECB)<br>
    Generated {{ generated_at }}<br>
    본 리포트는 정보 제공 목적이며 투자 조언이 아닙니다.
  </footer>

</div>
</body>
</html>
